{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1", "methods": ["GET", "POST"] },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
{
  "name": "ethiotrend-live",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vercel dev",
    "deploy": "vercel --prod"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "mongoose": "^8.0.0",
    "@upstash/redis": "^1.25.0",
    "openai": "^4.20.0",
    "xml2js": "^0.6.0"
  }
}
